        },
        "enable": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "API Runtime",
      "type": "link",
      "url": "/d/eventio-api"
    },
    {
      "title": "Availability",
      "type": "link",
