{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Golden Signals",
      "type": "link",
      "url": "/d/eventio-golden"
    },
    {
      "title": "API Runtime",
      "type": "link",
      "url": "/d/eventio-api"
    },
    {
      "title": "Availability",
      "type": "link",
      "url": "/d/eventio-availability"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Log volume (lines / min)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"eventio\"} |= `$search` [1m]))",
          "legendFormat": "lines/min",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error / warn matches",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "fillOpacity": 25
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"eventio\"} |~ `(?i)(error|exception|fatal|ECONN|ENOTFOUND)` [1m]))",
          "legendFormat": "errors",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({job=\"eventio\"} |~ `(?i)(warn|warning)` [1m]))",
          "legendFormat": "warnings",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx in logs",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "fillOpacity": 25
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"eventio\"} |~ `\"statusCode\":5[0-9][0-9]` [1m]))",
          "legendFormat": "5xx log lines",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Live logs",
      "type": "logs",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"eventio\"} |= `$search`",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "eventio",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ],
        "query": "",
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Eventio \u2014 Logs",
  "uid": "eventio-logs",
  "version": 1
}
