          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "expr": "eventio_nodejs_heap_total_bytes",
          "legendFormat": "heap total",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "expr": "eventio_nodejs_rss_bytes",
          "legendFormat": "rss",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "expr": "eventio_nodejs_external_bytes",
          "legendFormat": "external",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
