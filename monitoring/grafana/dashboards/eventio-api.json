          }
        }
      },
      "targets": [
        {
          "expr": "rate(eventio_process_cpu_user_seconds_total[5m])",
          "legendFormat": "user",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "expr": "rate(eventio_process_cpu_system_seconds_total[5m])",
          "legendFormat": "system",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
